[Unit]
Description=Scripps Pier cam kiosk playback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jasper
ExecStart=/home/jasper/work/pierviz/play_loop.sh
# Zero-copy decoding holds a dmabuf fd per decoded surface and climbs well past
# the default 1024 soft limit within a minute, at which point gpu-next logs
# "Failed to duplicate dmabuf fd: Too many open files" and renders nothing.
# The hard limit is already 524288.
LimitNOFILE=65536

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
